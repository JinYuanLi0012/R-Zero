{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JinYuanLi0012/R-Zero/qwen35/config.schema.json",
  "title": "R-Zero Qwen3.5 pipeline configuration",
  "type": "object",
  "required": [
    "schema_version",
    "profile",
    "model",
    "runtime",
    "hardware",
    "algorithm",
    "data",
    "generation",
    "checkpoint"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"enum": ["formal", "smoke"]},
    "model": {
      "type": "object",
      "required": ["id", "revision", "language_model_only"],
      "properties": {
        "id": {"const": "Qwen/Qwen3.5-4B-Base"},
        "revision": {"type": "string", "minLength": 7},
        "language_model_only": {"const": true}
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "cuda",
        "torch",
        "vllm",
        "transformers",
        "verl_ref",
        "base_image",
        "base_image_digest",
        "verl_source_root",
        "training_backend",
        "rollout_backend"
      ],
      "properties": {
        "cuda": {"const": "13.0.2"},
        "torch": {"const": "2.11.0"},
        "vllm": {"const": "0.24.0"},
        "transformers": {"const": "5.5.3"},
        "verl_ref": {"const": "4a2cba76f7f605d2b9f56e640faaeaa71c2c7f71"},
        "base_image": {"const": "verlai/verl:vllm024.dev2"},
        "base_image_digest": {"const": "sha256:b867883b0dd011363e69ab2ab344922a28c5bd0409e2a324e3ee70fb27ca7543"},
        "verl_source_root": {"const": "/opt/verl"},
        "training_backend": {"const": "fsdp2"},
        "rollout_backend": {"const": "vllm"}
      }
    },
    "hardware": {
      "type": "object",
      "required": ["gpus", "questioner_training_gpus", "questioner_solver_gpus"],
      "properties": {
        "gpus": {"const": [0, 1, 2, 3]},
        "questioner_training_gpus": {"const": [0, 1]},
        "questioner_solver_gpus": {"const": [2, 3]}
      }
    },
    "algorithm": {"type": "object"},
    "data": {"type": "object"},
    "generation": {"type": "object"},
    "checkpoint": {"type": "object"}
  },
  "additionalProperties": true
}
